{
  "name": "home-registry-frontend",
  "private": true,
  "version": "0.1.0-beta.3",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "sync-dist": "node sync-dist.js",
    "build:full": "npm run build && npm run sync-dist",
    "clean": "rimraf dist ../static",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-zones.mjs",
    "preview": "vite preview",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "heic2any": "^0.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "fs-extra": "^11.2.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "5.6.2",
    "typescript-eslint": "8.18.2",
    "vite": "6.4.1",
    "vite-plugin-pwa": "1.2.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "ajv": "6.12.6"
  }
}
